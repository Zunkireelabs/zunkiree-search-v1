# =============================================================================
# Zunkiree Search — clinic lane overlay env (P2 brief §4 B2)
#
# GENERATED FILE — never hand-edit backend/.env.clinic-prod on the VPS.
# deploy-clinic-lane.yml renders it fresh on every dispatch from the
# CLINICMD_SUPABASE_URL / CLINICMD_SUPABASE_ANON_KEY secrets in the GitHub
# production environment, and any manual edit is overwritten on the next
# deploy. This .example file is the only thing that's hand-maintained; it
# documents the shape, it is not copied to produce the real file.
#
# backend/.env.clinic-prod itself stays gitignored — never commit the real
# file. Layered ON TOP of backend/.env by docker-compose.yml's
# zunkiree-clinic-prod service (env_file: [.env, .env.clinic-prod], later
# file wins), so this only needs to hold what's DIFFERENT from the prod API
# container: the ClinicMD credentials, which exist on the lane and nowhere
# else.
#
# CLINICMD_* secret VALUES are set by Sadin in the GitHub production
# environment. This window verifies by name only — never fills in or
# regenerates these values.
# =============================================================================

CLINICMD_SUPABASE_URL=
CLINICMD_SUPABASE_ANON_KEY=

# DB_POOL_SIZE, DB_MAX_OVERFLOW, UVICORN_WORKERS, ENABLE_INBOUND_DISPATCHER
# are already set directly in docker-compose.yml's zunkiree-clinic-prod
# `environment:` block — don't duplicate them here.
